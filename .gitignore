# Raw UNSW-NB15 datasets & PDFs in root (never commit large raw datasets)
/Training and Testing Sets/
/UNSW-NB15_*.csv
/NUSW-NB15_*.csv
/ReadMe.pdf
/The UNSW-NB15 description.pdf

# Organized dataset directories (preserve directory placeholders only)
dataset/raw/*
!dataset/raw/.gitkeep
dataset/processed/*
!dataset/processed/.gitkeep

# Serialized models & local SQLite databases
models/binary/*
!models/binary/.gitkeep
models/multiclass/*
!models/multiclass/.gitkeep
database/*.db
database/*.db-*
database/*.sqlite*

# Generated large reports/figures (preserve structure)
reports/figures/*
!reports/figures/.gitkeep
