# Virtual environments & Python cache
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
build/
dist/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Secrets & environment config
.env
.env.*
!.env.example
.streamlit/secrets.toml

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs (preserve directory placeholder)
logs/*
!logs/.gitkeep

# Raw UNSW-NB15 datasets & documentation (never commit large raw datasets)
dataset/raw/*
!dataset/raw/.gitkeep
dataset/processed/*
!dataset/processed/.gitkeep

# Legacy root dataset safeguards
/Training and Testing Sets/
/UNSW-NB15_*.csv
/NUSW-NB15_*.csv
/ReadMe.pdf
/The UNSW-NB15 description.pdf

# Serialized models & local SQLite databases
models/binary/*
!models/binary/.gitkeep
models/multiclass/*
!models/multiclass/.gitkeep
database/*.db
database/*.db-*
database/*.sqlite*

# Generated large graph images (preserve directory placeholder)
reports/graphs/*
!reports/graphs/.gitkeep
